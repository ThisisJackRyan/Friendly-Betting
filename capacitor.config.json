{
  "appId": "com.friendlybetting.app",
  "appName": "FRIENDLY",
  "webDir": "dist-mobile",
  "backgroundColor": "#f6f7f2",
  "ios": {
    "contentInset": "never",
    "preferredContentMode": "mobile"
  },
  "plugins": {
    "FirebaseAuthentication": {
      "skipNativeAuth": true,
      "providers": [
        "phone"
      ]
    }
  },
  "experimental": {
    "ios": {
      "spm": {
        "packageOptions": {
          "@capacitor-firebase/authentication": {
            "symlink": true
          }
        },
        "swiftToolsVersion": "6.1",
        "packageTraits": {
          "@capacitor-firebase/authentication": [
            "Lite"
          ]
        }
      }
    }
  }
}
