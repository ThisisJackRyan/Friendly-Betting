rules_version = '2';

// Friendly Betting – Cloud Firestore security rules.
//
// DO NOT DEPLOY the undo / call-off rules (docs/UNDO-CALL-OFF.md) from this
// branch. They are tested against the emulator only; never run
// `firebase deploy` with them until that doc's checklist is done.
//
// DO NOT DEPLOY the per-voter vote rules (bets/{code}/votes/{uid}, the
// append-only legacy `votes` rule and the empty `votes` on create;
// docs/VOTE-SECURITY.md) either. They are phase 1 of a two-phase change with
// a required deploy order: the app that writes per-voter docs ships first,
// and these rules follow only once that doc's checklist is done. Tested
// against the emulator only.
//
// NOT AUTO-DEPLOYED. Nothing in this repo or on Vercel deploys this file.
// Before anyone runs `firebase deploy --only firestore:rules`, review it
// line by line against the rules currently live in the Firebase console
// (Firestore > Rules) for friendly-betting-fb47e, and merge anything the live
// rules allow that is missing here. Deploying it blindly could break paths
// that only the live rules know about.
//
// Tests: `npm run test:rules` (runs rules/firestore.rules.test.js against the
// local emulator).
//
// Every bet write comes from the browser through src/phone/api.js, so for
// bets these rules are the only real enforcement:
//   - createBet  -> create on bets/{code}
//   - castVote   -> create/update of the voter's own bets/{code}/votes/{uid};
//                   older builds append their own entry to `votes`
//   - renameVote -> name-only update of the voter's own vote doc
//   - saveBet    -> creator edit of their own open bet
//   - settleBet  -> creator close & settle with a winner
//   - callOffBet -> creator calls off an open bet (calledOff, no winner)
//   - undoSettle -> creator takes a settle back within 30s (35s here)
//   - deleteBet  -> creator delete, normally through the server route below;
//                   a client delete only when that route isn't configured
// A bet with no creator uid (createdByID) can't be closed, settled or deleted
// by anyone.
//
// Server code using Firestore: the result-text API routes
// (app/api/bets/[code]/result-texts/*), which never write bets/{code}, and the
// delete route (app/api/bets/[code]/route.js), which checks the same creator
// rule and deletes the bet with its private result-text numbers. Both use the
// Admin SDK, which bypasses these rules.

service cloud.firestore {
  match /databases/{database}/documents {

    // Fields that close or settle a bet. Only the creator may change them,
    // only through the settle, call-off and undo writes below. `calledOff` lives
    // here because the result-text server (src/server/resultTexts.js) texts
    // "called off" for any bet with calledOff == true; nothing else may set it.
    function resultFields() {
      return ['status', 'winnerId', 'settledAt', 'settlement', 'calledOff'];
    }

    // Fields nobody may change after create (other than through the
    // settle path for resultFields).
    function lockedFields() {
      return ['createdByID', 'code', 'createdAt'];
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Signed in with a verified phone number (the app's "creator" session).
    // Anonymous voters have no phone_number claim.
    function isPhoneUser() {
      return request.auth != null
        && request.auth.token.get('phone_number', null) != null;
    }

    // The signed-in phone user is the uid stored on the bet. A missing or
    // empty createdByID is no match (auth uids are never empty), so a bet
    // with no creator uid can't be edited, closed or settled by anyone.
    function isBetCreator(bet) {
      return isPhoneUser()
        && bet.get('createdByID', '') == request.auth.uid;
    }

    // Either marker calls a bet off, like isCalledOff in src/phone/betStatus.js.
    function isCalledOff(bet) {
      return bet.get('calledOff', false) == true
        || bet.get('status', 'open') == 'called-off';
    }

    // Legacy bets have no status field; treat them as open. A called-off bet
    // is never open, so it takes no votes and no edits.
    function isOpen(bet) {
      return bet.get('status', 'open') != 'closed' && !isCalledOff(bet);
    }

    function isSettled(bet) {
      return bet.get('status', 'open') == 'closed'
        && bet.get('winnerId', null) != null;
    }

    // The settle write's settledAt: the server time of this write
    // (serverTimestamp()), which is what the undo window is measured from.
    // A number is what older app builds write (Date.now()); those settles
    // can't be undone. Leaving it out is allowed as before.
    function validSettledAt() {
      return request.resource.data.get('settledAt', null) == null
        || request.resource.data.settledAt == request.time
        || request.resource.data.settledAt is number;
    }

    // The longest name on a pick (NAME_MAX in src/phone/votes.js).
    function nameMax() {
      return 30;
    }

    // The bet's side ids, worked out the way hydrateBet (src/phone/api.js)
    // does: a current bet lists its options; a CRA-era bet with a type and a
    // detail doc id has fixed sides (Money Line, Over Under) or one per prop
    // option in its PropBets doc. Rules have no loops, so a listed bet's
    // options are checked one index at a time; the app makes at most 4.
    function optionAt(options, i, id) {
      return options.size() > i && options[i].get('id', null) == id;
    }

    function listedOption(options, id) {
      return options is list && (optionAt(options, 0, id) || optionAt(options, 1, id)
        || optionAt(options, 2, id) || optionAt(options, 3, id)
        || optionAt(options, 4, id) || optionAt(options, 5, id)
        || optionAt(options, 6, id) || optionAt(options, 7, id));
    }

    function propOption(betID, id) {
      let count = get(/databases/$(database)/documents/PropBets/$(betID)).data.get('options', []).size();
      return id in ['p0', 'p1', 'p2', 'p3', 'p4', 'p5', 'p6', 'p7', 'p8', 'p9'][0:(count < 10 ? count : 10)];
    }

    function legacyOption(bet, id) {
      return (bet.type == 'Money Line' && id in ['a', 'b'])
        || (bet.type == 'Over Under' && id in ['over', 'under'])
        || (bet.type == 'Prop' && propOption(bet.betID, id));
    }

    function isBetOption(bet, id) {
      return id is string && (
        (bet.get('schemaVersion', null) == 2 && bet.get('options', null) is list)
          ? listedOption(bet.options, id)
          : (bet.get('betID', '') is string && bet.get('betID', '') != ''
              && bet.get('type', '') is string && bet.get('type', '') != '')
            ? legacyOption(bet, id)
            : listedOption(bet.get('options', null), id));
    }

    // A name on a pick: a string of at most nameMax() characters.
    function validName(name) {
      return name is string && name.size() <= nameMax();
    }

    // One entry an older build appends to the legacy `votes` array: the
    // caller's own pick, in the shape castVote has always written.
    function validLegacyVote(bet, vote) {
      return vote is map
        && vote.keys().hasOnly(['voterId', 'name', 'optionId', 'at'])
        && vote.get('voterId', null) == request.auth.uid
        && isBetOption(bet, vote.get('optionId', null))
        && validName(vote.get('name', ''))
        && vote.get('at', 0) is number;
    }

    // Phase 1 of docs/VOTE-SECURITY.md: the legacy array only grows, by one
    // entry of the caller's own at the end. Every entry already there stays
    // exactly as it was, so nobody can rewrite or drop anyone's pick. A voter
    // listed twice counts once, at their last entry (mergeVotes).
    function appendsOwnVote(bet) {
      let before = bet.get('votes', []);
      let after = request.resource.data.votes;
      return before is list && after is list
        && after.size() == before.size() + 1
        && (before.size() == 0 || after[0:before.size()] == before)
        && validLegacyVote(bet, after[before.size()]);
    }

    // A per-voter vote doc as castVote and renameVote write it: exactly these
    // fields, the voter's own uid, one of the bet's sides, a capped name and
    // a server time.
    function validVoteDoc(bet, uid) {
      let vote = request.resource.data;
      return vote.keys().hasOnly(['voterId', 'name', 'optionId', 'at'])
        && vote.keys().hasAll(['voterId', 'name', 'optionId', 'at'])
        && vote.voterId == uid
        && validName(vote.name)
        && isBetOption(bet, vote.optionId)
        && vote.at is timestamp;
    }

    // The creator's undo window after a settle. The app shows 30s; the extra
    // 5s lets a tap near the end land.
    function inUndoWindow(bet) {
      return bet.get('settledAt', null) is timestamp
        && request.time < bet.settledAt + duration.value(35, 's');
    }

    match /bets/{code} {
      // Anyone with the link can open a bet, signed in or not.
      allow get: if true;

      // Only "My bets" lists bets, and only its own (createdByID == uid).
      allow list: if request.auth != null
        && resource.data.createdByID == request.auth.uid;

      // createBet: a phone-verified user creates an open, unsettled bet in
      // their own name. createdByID must be the caller, so nobody can spoof
      // the creator. No result fields (settledAt, settlement, calledOff) yet.
      allow create: if isPhoneUser()
        && request.resource.data.createdByID == request.auth.uid
        && request.resource.data.get('status', 'open') == 'open'
        && request.resource.data.get('winnerId', null) == null
        && !request.resource.data.keys().hasAny(['settledAt', 'settlement', 'calledOff'])
        && request.resource.data.get('votes', []) == [];

      // castVote from older builds (phase 1, docs/VOTE-SECURITY.md): any
      // signed-in user (voters use anonymous auth) may append their own pick
      // to the legacy votes list on an open bet, and change nothing else.
      // Replacing or renaming an entry already there is refused; current
      // builds write bets/{code}/votes/{uid} instead. isOpen refuses a
      // called-off bet by either marker (calledOff true, status 'called-off').
      allow update: if request.auth != null
        && isOpen(resource.data)
        && changedKeys().hasOnly(['votes'])
        && appendsOwnVote(resource.data);

      // saveBet: the creator edits their own open bet. Result fields
      // (including calledOff), votes and the creator stay untouched.
      allow update: if isBetCreator(resource.data)
        && isOpen(resource.data)
        && !changedKeys().hasAny(resultFields().concat(lockedFields()).concat(['votes']));

      // settleBet: only the creator closes & settles a bet that is neither
      // settled nor called off. The write closes the bet (status 'closed')
      // with a non-empty winnerId; it may also set calledOff, which must then
      // be a bool (older settles named a winner on a called-off bet). After a
      // winner is set the result fields are immutable, except for the undo
      // below.
      allow update: if isBetCreator(resource.data)
        && !isSettled(resource.data)
        && !isCalledOff(resource.data)
        && changedKeys().hasOnly(resultFields())
        && request.resource.data.status == 'closed'
        && request.resource.data.winnerId is string
        && request.resource.data.winnerId != ''
        && validSettledAt()
        && (!changedKeys().hasAny(['calledOff'])
          || request.resource.data.calledOff is bool);

      // callOffBet: only the creator calls off an open bet. Closed, with
      // calledOff true, no winner and no settlement, stamped with the server
      // time. Final: no rule changes a called-off bet again.
      allow update: if isBetCreator(resource.data)
        && isOpen(resource.data)
        && changedKeys().hasOnly(resultFields())
        && request.resource.data.status == 'closed'
        && request.resource.data.calledOff == true
        && request.resource.data.get('winnerId', null) == null
        && !request.resource.data.keys().hasAny(['settlement'])
        && request.resource.data.settledAt == request.time;

      // undoSettle: only the creator, only on a settled (not called-off) bet
      // whose server settledAt is under 35s old. Only result fields change,
      // and the bet is left open: status 'open', no winner, and no settledAt,
      // settlement or calledOff.
      allow update: if isBetCreator(resource.data)
        && isSettled(resource.data)
        && !isCalledOff(resource.data)
        && inUndoWindow(resource.data)
        && changedKeys().hasOnly(resultFields())
        && request.resource.data.status == 'open'
        && request.resource.data.get('winnerId', null) == null
        && !request.resource.data.keys().hasAny(['settledAt', 'settlement', 'calledOff']);

      // deleteBet: only the creator. Legacy votes are embedded in the doc, so
      // they go with it; vote docs go in the same batch (below). Saved
      // result-text numbers (privateResultTexts) are client-denied; the
      // server route deletes them with the bet.
      allow delete: if isBetCreator(resource.data);

      // One voter's pick (docs/VOTE-SECURITY.md). The doc id is the voter's
      // auth uid, and only that user writes it, only while the bet is open
      // (isOpen: not closed, not called off). A voter may change sides
      // (castVote, which stamps a new server time) or only their name
      // (renameVote, same side and time). Voters never delete a pick.
      match /votes/{uid} {
        function bet() {
          return get(/databases/$(database)/documents/bets/$(code)).data;
        }

        // Readable like the bet itself: anyone with the link. A query of
        // one bet's votes only; nothing allows a collection group query.
        allow get, list: if true;

        allow create: if request.auth != null
          && request.auth.uid == uid
          && isOpen(bet())
          && validVoteDoc(bet(), uid)
          && request.resource.data.at == request.time;

        allow update: if request.auth != null
          && request.auth.uid == uid
          && isOpen(bet())
          && validVoteDoc(bet(), uid)
          && (request.resource.data.at == request.time
            || (request.resource.data.at == resource.data.at
              && request.resource.data.optionId == resource.data.optionId));

        // deleteBet's client fallback: the creator deletes the vote docs in
        // the same batch that deletes the bet, never on their own.
        allow delete: if isBetCreator(bet())
          && !existsAfter(/databases/$(database)/documents/bets/$(code));
      }
    }

    // Detail docs written by the old CRA app; hydrateBet reads them by id.
    // Read-only from the client now.
    match /MoneyLineBets/{id} {
      allow get: if true;
    }
    match /OverUnderBets/{id} {
      allow get: if true;
    }
    match /PropBets/{id} {
      allow get: if true;
    }

    // Voters' numbers for result texts (docs/result-texts.md). Only the Admin
    // SDK in the result-text API routes touches them, and it bypasses rules,
    // so no client may read or write them.
    match /privateResultTexts/{code}/{document=**} {
      allow read, write: if false;
    }

    // Pro entitlements (docs/PRO.md). A member reads their own plan; nobody
    // else can. Only the Admin SDK writes them (the mock purchase route on
    // previews today, store billing later), so no client can grant, extend or
    // remove Pro. Single-doc get only: no query can list entitlements, not
    // even a member's own. The read checks no fields, so legacy founder docs
    // still read.
    match /entitlements/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }
  }
}
